<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="scout_mini_follower">

  <xacro:arg name="prefix" default="scout_2_"/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <xacro:macro name="mini_wheel" params="name flip:=0.0">
    <link name="${prefix}${name}_wheel_link">
      <inertial>
        <mass value="3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.7171" iyz="0" izz="0.1361"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="${flip} 0 0" />
        <geometry>
          <mesh filename="file://$(find robot_description)/meshes/scout_mini_mesh/wheel.dae" />
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${flip} 0 0" />
        <geometry>
          <mesh filename="file://$(find robot_description)/meshes/scout_mini_mesh/wheel.dae" />
        </geometry>
      </collision>

    </link>
  </xacro:macro>

  <xacro:macro name="scout_mini_follower" params="odometry_source load_gazebo">

    <xacro:property name="track" value="0.490"/>
    <xacro:property name="wheel_radius" value="0.160"/>
    <xacro:property name="left_y_offset" value="0.0"/>

    <xacro:property name="wheel_x" value="0.2319755"/>
    <xacro:property name="wheel_y" value="0.2082515"/>
    <xacro:property name="wheel_z" value="-0.099998"/>

    <xacro:property name="base_x_size" value="0.65"/>
    <xacro:property name="base_y_size" value="0.45"/>
    <xacro:property name="base_z_size" value="0.22"/>

    <xacro:arg name="lidar_type" default="2d"/>
    <xacro:property name="lidar_type" value="$(arg lidar_type)"/>

    <!-- enable_sensors: set to false to avoid Fortress GPU multi-sensor crash -->
    <xacro:arg name="enable_sensors" default="true"/>
    <xacro:property name="enable_sensors" value="$(arg enable_sensors)"/>

    <xacro:if value="${lidar_type == '2d'}">
      <xacro:property name="lidar" value="lidar_2d"/>
    </xacro:if>

    <xacro:if value="${lidar_type == '3d'}">
      <xacro:property name="lidar" value="lidar_3d"/>
    </xacro:if>

    <link name="${prefix}base_footprint"/>

    <joint name="${prefix}base_footprint_to_base_link" type="fixed">
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <parent link="${prefix}base_footprint"/>
      <child link="${prefix}base_link"/>
    </joint>

    <link name="${prefix}base_link"/>

    <joint name="${prefix}base_link_to_mobile_robot" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}mobile_robot_base_link"/>
    </joint>

    <link name="${prefix}mobile_robot_base_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57 0 -1.57"/>
        <geometry>
          <mesh filename="file://$(find robot_description)/meshes/scout_mini_mesh/scout_mini_base_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57 0 -1.57"/>
        <geometry>
          <mesh filename="file://$(find robot_description)/meshes/scout_mini_mesh/scout_mini_base_link.dae"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
        <geometry>
          <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}inertial_link">
      <inertial>
        <mass value="132.3898489950015"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.185196122711036"
          ixy="4.30144213829512E-08"
          ixz="5.81037523686401E-08"
          iyy="0.364893736238929"
          iyz="-0.000386720198091934"
          izz="0.223868521722778"/>
      </inertial>
    </link>

    <joint name="${prefix}inertial_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}mobile_robot_base_link"/>
      <child link="${prefix}inertial_link"/>
    </joint>

    <xacro:mini_wheel name="front_left"  flip="${pi}" />
    <xacro:mini_wheel name="rear_left"   flip="${pi}" />
    <xacro:mini_wheel name="front_right" flip="0.0" />
    <xacro:mini_wheel name="rear_right"  flip="0.0" />

    <xacro:if value="${load_gazebo}">

      <joint name="${prefix}front_left_wheel" type="continuous">
        <origin rpy="1.57 0 0" xyz="${wheel_x} ${wheel_y + left_y_offset} ${wheel_z}"/>
        <parent link="${prefix}mobile_robot_base_link"/>
        <child link="${prefix}front_left_wheel_link"/>
        <axis xyz="0 0 -1"/>
      </joint>

      <joint name="${prefix}front_right_wheel" type="continuous">
        <origin rpy="1.57 0 0" xyz="${wheel_x} ${-wheel_y} ${wheel_z}"/>
        <parent link="${prefix}mobile_robot_base_link"/>
        <child link="${prefix}front_right_wheel_link"/>
        <axis xyz="0 0 -1"/>
      </joint>

      <joint name="${prefix}rear_left_wheel" type="continuous">
        <origin rpy="1.57 0 0" xyz="${-wheel_x} ${wheel_y + left_y_offset} ${wheel_z}"/>
        <parent link="${prefix}mobile_robot_base_link"/>
        <child link="${prefix}rear_left_wheel_link"/>
        <axis xyz="0 0 -1"/>
      </joint>

      <joint name="${prefix}rear_right_wheel" type="continuous">
        <origin rpy="1.57 0 0" xyz="${-wheel_x} ${-wheel_y} ${wheel_z}"/>
        <parent link="${prefix}mobile_robot_base_link"/>
        <child link="${prefix}rear_right_wheel_link"/>
        <axis xyz="0 0 -1"/>
      </joint>

      <!-- ============================================================ -->
      <!-- GPU SENSORS — only loaded when enable_sensors is true        -->
      <!-- Fortress crashes with multiple GPU sensors across models     -->
      <!-- ============================================================ -->
      <xacro:if value="${enable_sensors}">
        <gazebo>
          <plugin filename="ignition-gazebo-sensors-system"
                  name="ignition::gazebo::systems::Sensors">
            <render_engine>ogre2</render_engine>
          </plugin>

          <plugin filename="ignition-gazebo-imu-system"
                  name="ignition::gazebo::systems::Imu" />
        </gazebo>
      



        <gazebo reference="${prefix}imu_frame">
          <sensor name="follower_imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>50</update_rate>
            <ignition_frame_id>${prefix}imu_frame</ignition_frame_id>
            <visualize>true</visualize>
            <topic>/follower/imu</topic>
          </sensor>
        </gazebo>

        <!-- 2D Lidar -->
        <xacro:if value="${lidar_type == '2d'}">
          <gazebo reference="${prefix}lidar_2d">
            <sensor name="follower_gpu_lidar" type="gpu_ray">
              <topic>/follower/scan</topic>
              <update_rate>10</update_rate>
              <ignition_frame_id>${prefix}lidar_2d</ignition_frame_id>
              <ray>
                <scan>
                  <horizontal>
                    <samples>720</samples>
                    <resolution>1</resolution>
                    <min_angle>0.0</min_angle>
                    <max_angle>${2.0*pi}</max_angle>
                  </horizontal>
                </scan>
                <range>
                  <min>0.55</min>
                  <max>16</max>
                  <resolution>0.01</resolution>
                </range>
                <noise>
                  <type>gaussian</type>
                  <mean>0.0</mean>
                  <stddev>0.001</stddev>
                </noise>
              </ray>
              <alwaysOn>1</alwaysOn>
              <visualize>true</visualize>
            </sensor>
          </gazebo>
        </xacro:if>

        <!-- 3D Lidar -->
        <xacro:if value="${lidar_type == '3d'}">
          <gazebo reference="${prefix}lidar_3d">
            <sensor name="follower_gpu_lidar_3d" type="gpu_ray">
              <topic>/follower/pointcloud</topic>
              <update_rate>10</update_rate>
              <ignition_frame_id>${prefix}lidar_3d</ignition_frame_id>
              <ray>
                <scan>
                  <horizontal>
                    <samples>1024</samples>
                    <resolution>0.001</resolution>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                  </horizontal>
                  <vertical>
                    <samples>32</samples>
                    <resolution>0.001</resolution>
                    <min_angle>-0.393</min_angle>
                    <max_angle>0.393</max_angle>
                  </vertical>
                </scan>
                <range>
                  <min>0.5</min>
                  <max>50.0</max>
                  <resolution>0.005</resolution>
                </range>
                <noise>
                  <type>gaussian</type>
                  <mean>0.0</mean>
                  <stddev>0.001</stddev>
                </noise>
              </ray>
              <alwaysOn>1</alwaysOn>
              <visualize>true</visualize>
            </sensor>
          </gazebo>
        </xacro:if>

      </xacro:if>
      <!-- ============================================================ -->
      <!-- END GPU SENSORS conditional                                  -->
      <!-- ============================================================ -->

      <!-- gpu_ray lidar — loads when enable_sensors is false              -->
      <!-- Uses gpu_ray type (not gpu_lidar) to avoid the ogre2 crash    -->
      <!-- The leader's Sensors plugin serves both models in Fortress    -->
      <xacro:unless value="${enable_sensors}">
        <xacro:if value="${lidar_type == '2d'}">
          <gazebo reference="${prefix}lidar_2d">
            <sensor name="follower_ray_lidar" type="gpu_ray">
              <topic>/follower/scan</topic>
              <update_rate>10</update_rate>
              <ignition_frame_id>${prefix}lidar_2d</ignition_frame_id>
              <ray>
                <scan>
                  <horizontal>
                    <samples>720</samples>
                    <resolution>1</resolution>
                    <min_angle>0.0</min_angle>
                    <max_angle>${2.0*pi}</max_angle>
                  </horizontal>
                </scan>
                <range>
                  <min>0.55</min>
                  <max>16</max>
                  <resolution>0.01</resolution>
                </range>
                <noise>
                  <type>gaussian</type>
                  <mean>0.0</mean>
                  <stddev>0.001</stddev>
                </noise>
              </ray>
              <alwaysOn>1</alwaysOn>
              <visualize>false</visualize>
            </sensor>
          </gazebo>
        </xacro:if>

        <xacro:if value="${lidar_type == '3d'}">
          <gazebo reference="${prefix}lidar_3d">
            <sensor name="follower_ray_lidar_3d" type="gpu_ray">
              <topic>/follower/pointcloud</topic>
              <update_rate>10</update_rate>
              <ignition_frame_id>${prefix}lidar_3d</ignition_frame_id>
              <ray>
                <scan>
                  <horizontal>
                    <samples>1024</samples>
                    <resolution>0.001</resolution>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                  </horizontal>
                  <vertical>
                    <samples>32</samples>
                    <resolution>0.001</resolution>
                    <min_angle>-0.393</min_angle>
                    <max_angle>0.393</max_angle>
                  </vertical>
                </scan>
                <range>
                  <min>0.5</min>
                  <max>50.0</max>
                  <resolution>0.005</resolution>
                </range>
                <noise>
                  <type>gaussian</type>
                  <mean>0.0</mean>
                  <stddev>0.001</stddev>
                </noise>
              </ray>
              <alwaysOn>1</alwaysOn>
              <visualize>false</visualize>
            </sensor>
          </gazebo>
        </xacro:if>
      </xacro:unless>

      <!-- These plugins are NOT GPU-based — always loaded -->
      <gazebo>
        <plugin filename="ignition-gazebo-joint-state-publisher-system"
                name="ignition::gazebo::systems::JointStatePublisher" />
      </gazebo>
      <gazebo>
        <plugin filename="ignition-gazebo-navsat-system"
          name="ignition::gazebo::systems::NavSat" />
    </gazebo>
      <gazebo>
        <plugin filename="ignition-gazebo-diff-drive-system"
                name="ignition::gazebo::systems::DiffDrive">
          <left_joint>${prefix}front_left_wheel</left_joint>
          <left_joint>${prefix}rear_left_wheel</left_joint>
          <right_joint>${prefix}front_right_wheel</right_joint>
          <right_joint>${prefix}rear_right_wheel</right_joint>

          <wheel_separation>${track}</wheel_separation>
          <wheel_radius>${wheel_radius}</wheel_radius>

          <topic>/follower/cmd_vel</topic>

          <xacro:if value="${odometry_source == 'encoders'}">
            <odom_topic>/follower/odom</odom_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
            <tf_topic>/follower/tf</tf_topic>
          </xacro:if>

          <frame_id>follower/odom</frame_id>
          <child_frame_id>${prefix}base_footprint</child_frame_id>

          <max_linear_acceleration>2</max_linear_acceleration>
          <min_linear_acceleration>-2</min_linear_acceleration>
          <max_angular_acceleration>1</max_angular_acceleration>
          <min_angular_acceleration>-1</min_angular_acceleration>
          <max_linear_velocity>10</max_linear_velocity>
          <min_linear_velocity>-10</min_linear_velocity>
          <max_angular_velocity>1</max_angular_velocity>
          <min_angular_velocity>-1</min_angular_velocity>
        </plugin>
      </gazebo>

      <xacro:if value="${odometry_source == 'ground_truth'}">
        <gazebo>
          <plugin filename="libignition-gazebo6-odometry-publisher-system"
                  name="ignition::gazebo::systems::OdometryPublisher">
            <odom_frame>follower/odom</odom_frame>
            <robot_base_frame>${prefix}base_footprint</robot_base_frame>
            <odom_topic>/follower/odom</odom_topic>
            <tf_topic>/follower/tf</tf_topic>
            <dimensions>2</dimensions>
            <odom_publish_frequency>50</odom_publish_frequency>
            <gaussian_noise>0.001</gaussian_noise>
          </plugin>
        </gazebo>
      </xacro:if>

      <link name="${prefix}gps_link">
        <inertial>
          <mass value="0.01"/>
          <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
      </link>


      <joint name="${prefix}mobile_robot_to_gps" type="fixed">
        <parent link="${prefix}mobile_robot_base_link"/>
        <child link="${prefix}gps_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>

      <gazebo reference="${prefix}gps_link">
        <sensor name="navsat_sensor" type="navsat">
          <topic>/follower/navsat</topic>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <ignition_frame_id>${prefix}gps_link</ignition_frame_id>
          <navsat>
            <position_sensing>
              <horizontal>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.0000001</stddev>
                </noise>
              </horizontal>
              <vertical>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.0000001</stddev>
                </noise>
              </vertical>
            </position_sensing>
          </navsat>
        </sensor>
      </gazebo>
    </xacro:if>

    <xacro:unless value="${load_gazebo}">

      <joint name="${prefix}front_left_wheel" type="fixed">
        <origin rpy="1.57 0 0" xyz="${wheel_x} ${wheel_y + left_y_offset} ${wheel_z}"/>
        <parent link="${prefix}mobile_robot_base_link"/>
        <child link="${prefix}front_left_wheel_link"/>
      </joint>

      <joint name="${prefix}front_right_wheel" type="fixed">
        <origin rpy="1.57 0 0" xyz="${wheel_x} ${-wheel_y} ${wheel_z}"/>
        <parent link="${prefix}mobile_robot_base_link"/>
        <child link="${prefix}front_right_wheel_link"/>
      </joint>

      <joint name="${prefix}rear_left_wheel" type="fixed">
        <origin rpy="1.57 0 0" xyz="${-wheel_x} ${wheel_y + left_y_offset} ${wheel_z}"/>
        <parent link="${prefix}mobile_robot_base_link"/>
        <child link="${prefix}rear_left_wheel_link"/>
      </joint>

      <joint name="${prefix}rear_right_wheel" type="fixed">
        <origin rpy="1.57 0 0" xyz="${-wheel_x} ${-wheel_y} ${wheel_z}"/>
        <parent link="${prefix}mobile_robot_base_link"/>
        <child link="${prefix}rear_right_wheel_link"/>
      </joint>

    </xacro:unless>

    <link name="${prefix}imu_frame"/>

    <joint name="${prefix}mobile_robot_to_imu" type="fixed">
      <parent link="${prefix}mobile_robot_base_link"/>
      <child link="${prefix}imu_frame"/>
      <origin xyz="0.0 0.0 0.08" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}${lidar}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.06" radius="0.075"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.06" radius="0.075"/>
        </geometry>
      </visual> 
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="${0.1 *(3*0.075*0.075 + 0.06*0.06)/ 12}" ixy="0" ixz="0"
                 iyy="${0.1 *(3*0.075*0.075 + 0.06*0.06)/ 12}"
                 iyz="0" izz="${0.1*0.075*0.075 / 2}"/>
      </inertial>
    </link>

    <joint name="${prefix}mobile_robot_to_${lidar}" type="fixed">
      <parent link="${prefix}mobile_robot_base_link"/>
      <child link="${prefix}${lidar}"/>
      <origin xyz="0.15 0.12 0.35" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>


