HOW TO RUN PICK AND PLACE PACKAGE

--ACTIVATE CAN--
canup

--LAUNCH VISION--
cd ~/Group7LitterRobot/sapling_ws
source install/setup.bash
ros2 launch computer_vision vision_start.launch.py

--ACTIVATE ARM--
cd ~/Group7LitterRobot/sapling_ws
source install/setup.bash
ros2 launch piper start_single_piper.launch.py can_port:=can_arm


--ACTIVATE MOVEIT-- 
cd ~/Group7LitterRobot/sapling_ws
source install/setup.bash
ros2 launch piper_with_gripper_moveit demo.launch.py 

--IF COLLISION OBJECTS DO NOT SPAWN--
cd ~/Group7LitterRobot/sapling_ws
source install/setup.bash
ros2 run add_zones_pkg add_zones_node

--ALLOW DROP--
ros2 topic pub --once /comms/follower_to_leader sapling_interfaces/msg/FollowerStatus "{seq: 0, parked: false, park_x: 0.0, park_y: 0.0, bin_ready: true}"

-- NAV --
ros2 topic pub --once /start_grasp std_msgs/msg/Bool "{data: true}"


ros2 topic pub --once /drive_front_3m std_msgs/msg/Bool '{data: true}'


from rclpy.qos import QoSProfile, DurabilityPolicy

latch_qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL)

( IN NODE CLASS START)
self.start_grasp_pub = self.create_publisher(Bool, '/start_grasp', latch_qos)